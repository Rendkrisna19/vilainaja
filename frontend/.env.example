# Salin file ini menjadi .env lalu sesuaikan.
# Nilai VITE_* ditanam saat build (npm run build), jadi set sebelum build di server/CI.

# Alamat API Laravel (harus diakhiri /api)
VITE_API_URL=http://localhost:8000/api

# Nama brand yang tampil di panel admin
VITE_APP_NAME=vilainaja

# Firebase (login Google) — Firebase Console → Project settings → Your apps → Web app.
# Aktifkan Authentication → Sign-in method → Google, dan tambahkan domain situs ke "Authorized domains".
# Kosongkan untuk menyembunyikan tombol "Masuk dengan Google".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
